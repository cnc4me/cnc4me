{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "./tsconfig.build.json",
  "entryPoints": [
    "./src/index.ts"
  ],
  "excludeExternals": true,
  "externalPattern": [
    "**/xstate/**/*.ts"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "noUnusedLocals": false,
  },
  "plugin": [
    "typedoc-plugin-missing-exports"
  ]
}
