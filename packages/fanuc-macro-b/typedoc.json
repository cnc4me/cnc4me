{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "./tsconfig.build.json",
  "entryPoints": [
    "./src/index.ts"
  ],
  "excludeExternals": true,
  // "useTsLinkResolution": false,
  "externalPattern": [
    "**/xstate/**/*.ts"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "lib": [
      "DOM",
      "ESNext"
    ],
    "types": [
      "node"
    ]
  },
  "plugin": [
    "typedoc-plugin-missing-exports"
  ]
}