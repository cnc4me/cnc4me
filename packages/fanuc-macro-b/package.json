{
  "name": "@cnc4me/fanuc-macro-b",
  "version": "1.0.0",
  "private": true,
  "description": "Virtual implementation of a fanuc gcode interpreter and execution environment",
  "license": "MIT",
  "author": "Kevin Hill",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "diagram": "ts-node-esm --swc ./scripts/generateDiagram.ts",
    "events": "tsnd --respawn ./demo/events.demo.ts",
    "insights": "cross-env DEBUG=macro:* tsnd --respawn ./demo/insights.demo.ts",
    "repl": "tsnd ./demo/repl.demo.ts",
    "runtime": "tsnd --respawn ./demo/runtime.demo.ts",
    "runtime:debug": "cross-env DEBUG=macro:* tsnd --respawn ./demo/runtime.demo.ts",
    "test": "vitest",
    "test:mem": "vitest MacroMemory",
    "types": "ts-node-esm --swc ./scripts/generateDts.ts"
  },
  "dependencies": {
    "chevrotain": "^10.1.2",
    "debug": "^4.3.4",
    "emittery": "^0.10.1",
    "lodash": "^4.17.21",
    "ts-pattern": "^3.3.5"
  },
  "devDependencies": {
    "@chevrotain/types": "^10.1.2",
    "@cnc4me/chevrotain-types-generator": "workspace:*",
    "@cnc4me/vitest-expect-ext": "workspace:*",
    "@optimize-lodash/rollup-plugin": "^5.0.0",
    "@swc/core": "^1.2.189",
    "@types/chance": "^1.1.3",
    "@types/debug": "^4.1.7",
    "@types/lodash": "^4.14.180",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "chance": "^1.1.8",
    "cross-env": "^7.0.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "prettier": "catalog:",
    "rollup": "^4",
    "rollup-plugin-dts": "^4.2.1",
    "ts-node": "^10.8.0",
    "ts-node-dev": "^1.1.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}