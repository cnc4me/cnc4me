{
  "name": "@cnc4me/fanuc-macro-b",
  "version": "1.0.0",
  "private": true,
  "description": "Virtual implementation of a Fanuc gcode interpreter and execution environment",
  "license": "MIT",
  "author": "Kevin Hill",
  "exports": "./src/index.ts",
  "main": "./build/FanucMacroB.js",
  "scripts": {
    "assets": "pnpm assets:types && pnpm assets:dts && pnpm assets:alarms && pnpm diagrams",
    "assets:alarms": "tsx ./scripts/generateAlarms.ts",
    "assets:dts": "tsx ./scripts/generateDts.ts",
    "assets:types": "tsx ./scripts/generateTypes.ts",
    "build": "pnpm assets && vite build",
    "coverage": "vitest run --coverage",
    "debug:runtime": "cross-env DEBUG=macro:* tsx --watch ./demo/runtime.demo.ts",
    "demo:events": "tsx --watch ./demo/events.demo.ts",
    "demo:runtime": "tsx --watch ./demo/runtime.demo.ts",
    "diagram:language": "tsx ./scripts/generateLanguageDiagram.ts",
    "diagram:runtime": "tsx ./scripts/generateRuntimeDiagram.ts",
    "diagram:ui": "tsx ./scripts/diagramHost.ts",
    "diagrams": "pnpm diagram:language && pnpm diagram:runtime",
    "repl": "tsx ./demo/repl.demo.ts",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@cnc4me/monaco-gcode": "workspace:*",
    "chevrotain": "catalog:",
    "debug": "catalog:",
    "mitt": "^3.0.1",
    "radash": "^12.1.0",
    "ts-pattern": "^5.5.0",
    "typescript-fsm": "^1.4.5"
  },
  "devDependencies": {
    "@types/chance": "^1.1.3",
    "@types/debug": "^4.1.7",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/coverage-v8": "^2.1.5",
    "@vitest/expect": "catalog:",
    "@vitest/ui": "2.1.5",
    "chance": "^1.1.8",
    "cross-env": "^7.0.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "prettier": "catalog:",
    "rollup": "^4",
    "rollup-plugin-define": "^1.0.1",
    "rollup-plugin-dts": "^6.1.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}