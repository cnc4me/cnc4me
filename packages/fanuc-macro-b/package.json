{
  "name": "@cnc4me/fanuc-macro-b",
  "version": "1.0.0",
  "private": true,
  "description": "Virtual implementation of a Fanuc gcode interpreter and execution environment",
  "license": "MIT",
  "author": "Kevin Hill",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "assets": "pnpm concurrently -c auto --pad-prefix \"pnpm:assets:*\"",
    "assets:alarms": "tsx ./scripts/generateAlarms.ts",
    "assets:docs": "typedoc --options ./typedoc.json",
    "assets:dts": "tsx ./scripts/generateDts.ts",
    "assets:types": "tsx ./scripts/generateTypes.ts",
    "parse-tree-dev": "",
    "build": "pnpm assets && vite build",
    "coverage": "vitest run --coverage",
    "debug:runtime": "cross-env DEBUG=fanuc:machine*,fanuc:runtime* pnpm tsx watch ./demo/runtime.demo.ts",
    "demo:events": "tsx --watch ./demo/events.demo.ts",
    "demo:runtime": "tsx --watch ./demo/runtime.demo.ts",
    "dev-parser": "tsx watch --include \"./src/core/*\" ./scripts/generateLanguageDiagram.ts",
    "diagram:language": "tsx watch --include \"./src/core/*\" ./scripts/generateLanguageDiagram.ts",
    "diagram:runtime": "tsx ./scripts/generateRuntimeDiagram.ts",
    "diagram:ui": "tsx ./scripts/diagramHost.ts",
    "diagrams": "pnpm diagram:language && pnpm diagram:runtime",
    "repl": "tsx ./demo/repl.demo.ts",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@cnc4me/monaco-gcode": "workspace:*",
    "chevrotain": "catalog:",
    "debug": "catalog:",
    "emittery": "^1.0.3",
    "p-queue": "^8.0.1",
    "radashi": "^12.3.0",
    "ts-pattern": "^5.5.0",
    "typescript-fsm": "^1.5.2",
    "xstate": "^5.19.0"
  },
  "devDependencies": {
    "@types/chance": "^1.1.3",
    "@types/debug": "^4.1.12",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/expect": "catalog:",
    "@vitest/ui": "catalog:",
    "chance": "^1.1.8",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-tsdoc": "^0.4.0",
    "prettier": "catalog:",
    "rollup": "^4",
    "rollup-plugin-define": "^1.0.1",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "tsx": "catalog:",
    "typedoc": "^0.27.6",
    "typedoc-plugin-missing-exports": "^3.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "catalog:"
  }
}