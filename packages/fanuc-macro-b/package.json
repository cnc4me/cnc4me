{
  "name": "@cnc4me/fanuc-macro-b",
  "version": "1.0.0",
  "private": true,
  "description": "Virtual implementation of a fanuc gcode interpreter and execution environment",
  "license": "MIT",
  "author": "Kevin Hill",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "src/index.ts",
  "scripts": {
    "build": "vite build",
    "coverage": "vitest run --coverage",
    "debug:insights": "cross-env DEBUG=macro:* tsx --watch ./demo/insights.demo.ts",
    "debug:runtime": "cross-env DEBUG=macro:* tsx --watch ./demo/runtime.demo.ts",
    "events": "tsx --watch ./demo/events.demo.ts",
    "gen:diagram": "tsx ./scripts/generateDiagram.ts",
    "gen:types": "tsx ./scripts/generateDts.ts",
    "repl": "tsx ./demo/repl.demo.ts",
    "runtime": "tsx --watch ./demo/runtime.demo.ts",
    "test": "vitest",
    "test:mem": "vitest MacroMemory",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "chevrotain": "catalog:",
    "debug": "catalog:",
    "emittery": "^1.0.3",
    "mitt": "^3.0.1",
    "radash": "^12.1.0",
    "ts-pattern": "^5.5.0"
  },
  "devDependencies": {
    "@cnc4me/monaco-gcode": "workspace:*",
    "@cnc4me/chevrotain-types-generator": "workspace:*",
    "@types/chance": "^1.1.3",
    "@types/debug": "^4.1.7",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/coverage-v8": "^2.1.5",
    "@vitest/expect": "catalog:",
    "@vitest/ui": "2.1.5",
    "chance": "^1.1.8",
    "cross-env": "^7.0.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "prettier": "catalog:",
    "rollup": "^4",
    "rollup-plugin-define": "^1.0.1",
    "rollup-plugin-dts": "^6.1.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}