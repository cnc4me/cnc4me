{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "rootDir": ".",
    "outDir": "dist",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "lib": [
      "DOM",
      "ESNext"
    ]
  },
  "files": [
    "vite.config.ts",
    "./tests/_vitest/vitest.expect.d.ts"
  ],
  "include": [
    "./src/**/*.ts",
    "./src/lib/*.json",
    "./tests/**/*.ts"
  ],
  "references": [
    {
      "path": "../monaco-gcode"
    },
  ]
}