{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "lib": [
      "DOM",
      "ESNext"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "files": [
    "./tests/_vitest/vitest.expect.d.ts"
  ],
  "include": [
    "vite.config.*",
    "./src/**/*.ts",
    "./src/lib/*.json",
    "./tests/**/*.ts",
    "./demo/*.ts",
    "./scripts/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}