{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "noEmit": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "lib": [
      "DOM",
      "ES2023"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "./src/types/fanuc.d.ts",
      "./tests/_vitest/vitest.d.ts"
    ]
  },
  "include": [
    "vite.config.*",
    "src/**/*.ts",
    "src/lib/*.json",
    "demo",
    "tests",
    "scripts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}