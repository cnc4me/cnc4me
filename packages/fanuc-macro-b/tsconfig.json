{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "lib": [
      "DOM",
      "ESNext"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "files": [
    "./src/types/fanuc.d.ts",
    "./tests/_vitest/vitest.expect.d.ts"
  ],
  "include": [
    "vite.config.*",
    "src",
    "src/lib/*.json",
    "demo",
    "tests",
    "scripts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
