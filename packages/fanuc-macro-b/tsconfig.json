{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "lib": [
      "DOM",
      "ESNext"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "./src/types/fanuc.d.ts",
      "./tests/_vitest/vitest.d.ts"
    ]
  },
  "include": [
    "vite.config.*",
    "src/**/*.ts",
    "src/lib/*.json",
    "demo",
    "tests",
    "scripts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}