{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "./*.js",
    "./*.ts",
    "./apps/**/*.js",
    "./apps/**/*.ts",
    "./apps/**/*.d.ts",
    "./apps/**/*.tsx",
    "./tools/**/*.js",
    "./tools/**/*.ts",
    "./packages/**/*.js",
    "./packages/**/*.ts",
    "./packages/**/*.mjs"
  ]
}