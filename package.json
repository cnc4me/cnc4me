{
  "name": "@cnc4me/cnc4me",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages",
    "apps"
  ],
  "scripts": {
    "build:playground": "pnpm -F macro-playground build",
    "playground": "pnpm -F macro-playground dev",
    "spindle-demo": "pnpm run -F spindle-demo start",
    "subtree:monaco-gcode": "git subtree push --prefix packages/monaco-gcode monaco-gcode main",
    "subtree:playground": "git subtree push --prefix apps/macro-playground macro-playground main",
    "test": "pnpm -F \"@cnc4me/*\" test",
    "github-workflow-test": "act -P ubuntu-latest=-self-hosted --container-architecture linux/amd64"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/eslint-plugin": "^1.1.10",
    "concurrently": "^9.1.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "prettier": "catalog:",
    "process": "^0.11.10",
    "rimraf": "^3.0.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "pnpm": "*"
  }
}
